# ==============================================================================
# V Notice - Configuration Environment Variables (.env.example)
# ==============================================================================

# --- Authentication & Security ---
# Admin Portal Authentication Password (default: vnotice2026)
ADMIN_PASSWORD=vnotice2026

# Optional password hash (takes precedence over plaintext ADMIN_PASSWORD)
# Generate via: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_pass'))"
ADMIN_PASSWORD_HASH=

# Secret key for session cookie encryption (MANDATORY in production: FLASK_ENV=production or PRODUCTION=true)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_hex_string_here_for_production

# Optional ephemeral dev secret key override for local testing
DEV_SECRET_KEY=

# Production enforcement flag (strict security checks: refuses to start if insecure secret)
PRODUCTION=false
FLASK_ENV=development

# --- Server Ports & Networking ---
# Server Ports for dual-port on-campus mode (Raspberry Pi / Local Network)
DISPLAY_PORT=5000
ADMIN_PORT=5001

# Dynamic Single Port (used by Cloud PaaS: Render / Railway unified app mode)
PORT=5000

# Server IP override for local QR codes (defaults to auto-detected LAN IP)
SERVER_IP=

# Public Base URL for Scan-to-Download QR Code (e.g., https://v-notice.onrender.com)
# If empty, automatically falls back to request origin or LAN IP
PUBLIC_BASE_URL=

# --- Data & Storage Layer ---
# Base Storage Directory for SQLite database and uploads
STORAGE_DIR=./

# SQLite Database File Path (defaults to ${STORAGE_DIR}/notices.db)
DB_FILE=./notices.db

# Media Storage Directory (defaults to ${STORAGE_DIR}/media)
MEDIA_DIR=./media

# Cloudinary Permanent Media Storage (Optional, Recommended for Free Hosting without persistent disks)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Maximum upload limits (default: 200MB)
MAX_UPLOAD_MB=200
MAX_CONTENT_LENGTH=209715200

# --- Audio & Video Features ---
# Video sound playback policy (default: true; audio plays only on unmuted screens)
VIDEO_SOUND_ENABLED=true

# Voice Announcements toggle and limits
VOICE_NOTICES_ENABLED=true
MAX_VOICE_DURATION_SECONDS=120
MAX_VOICE_UPLOAD_MB=10

# Urgent Notice Audio Chime (default: false; synthesized client-side via Web Audio API)
URGENT_CHIME=false

# --- Special Scheduled Events ---
# Daily 11:00 AM National Flag screen ceremony (strictly visual, zero audio)
FLAG_EVENT_ENABLED=true

# Shared secret token for triggering/testing flag broadcast via API
FLAG_TRIGGER_TOKEN=

# --- Campus Weather Widget ---
WEATHER_ENABLED=true
WEATHER_LABEL=Mumbai
WEATHER_LAT=19.0760
WEATHER_LON=72.8777
# Backwards-compatible aliases:
# CAMPUS_CITY=Mumbai
# CAMPUS_LAT=19.0760
# CAMPUS_LON=72.8777

# --- Real-Time Sync & Polling ---
# Server-Sent Events (SSE) stream toggle (default: false on cloud sync workers, true for threaded local)
SSE_ENABLED=false

# Polling interval in seconds for Kiosk display (default: 5)
POLL_INTERVAL_SECONDS=5

# --- Observability, Logging & Testing ---
# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Test mode isolation flag (used internally by test suites)
VNOTICE_TEST_MODE=0
