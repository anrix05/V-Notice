# ==============================================================================
# V Notice - Configuration Environment Variables
# ==============================================================================

# Admin Portal Authentication Password (default: vnotice2026)
ADMIN_PASSWORD=vnotice2026

# Server Ports (Mode B: local dual-port mode)
DISPLAY_PORT=5000
ADMIN_PORT=5001

# Dynamic Port (Mode A: Render / Railway / Cloud unified mode)
PORT=5000

# Base Storage Directory for SQLite database and uploads
STORAGE_DIR=./

# Media Storage Directory (defaults to ${STORAGE_DIR}/media)
MEDIA_DIR=./media

# SQLite Database File Path (defaults to ${STORAGE_DIR}/notices.db)
DB_FILE=./notices.db

# Campus Location for Weather Widget (defaults to Mumbai)
CAMPUS_CITY=MUMBAI
CAMPUS_LAT=19.0760
CAMPUS_LON=72.8777

# File Upload Limit (Bytes, default 200MB)
MAX_CONTENT_LENGTH=209715200
