# ==============================================================================
# V Notice - Configuration Environment Variables
# ==============================================================================

# Admin Portal Authentication Password (default: vnotice2026)
ADMIN_PASSWORD=vnotice2026

# Server Ports (Mode B: local dual-port mode)
DISPLAY_PORT=5000
ADMIN_PORT=5001

# Dynamic Port (Mode A: Render / Railway / Cloud unified mode)
PORT=5000

# Base Storage Directory for SQLite database and uploads
STORAGE_DIR=./

# Media Storage Directory (defaults to ${STORAGE_DIR}/media)
MEDIA_DIR=./media

# SQLite Database File Path (defaults to ${STORAGE_DIR}/notices.db)
DB_FILE=./notices.db

# Weather Configuration (Phase 3: Resilient & Gracefully Degrading)
WEATHER_ENABLED=true
WEATHER_LABEL=Mumbai
WEATHER_LAT=19.0760
WEATHER_LON=72.8777
# Backwards-compatible aliases:
# CAMPUS_CITY=MUMBAI
# CAMPUS_LAT=19.0760
# CAMPUS_LON=72.8777

# Public Base URL for Scan-to-Download QR Code (e.g., https://v-notice.onrender.com)
# If empty, automatically falls back to request origin or LAN IP
PUBLIC_BASE_URL=

# Urgent Notice Audio Chime (default: false; purely client-side synthesized via Web Audio API)
URGENT_CHIME=false

# File Upload Limit (Bytes, default 200MB)
MAX_CONTENT_LENGTH=209715200

# Secret key for session cookie encryption (MANDATORY in production)
SECRET_KEY=generate_a_random_hex_string_here_for_production

# Optional password hash (takes precedence over plaintext ADMIN_PASSWORD)
# Generate via: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_pass'))"
ADMIN_PASSWORD_HASH=

# Maximum upload limit in Megabytes (default: 200)
MAX_UPLOAD_MB=200
